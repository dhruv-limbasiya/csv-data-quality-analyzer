# ============================================
# CSV Data Quality Analyzer — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# Production values are managed in the hosting provider; production secrets must be unique.

# Database connection string
DATABASE_URL=postgresql://csv_analyzer_app:YOUR_PASSWORD_HERE@localhost:5432/csv_data_quality_analyzer

# Secret key for JWT / session signing (generate a random string)
SECRET_KEY=change-me-to-a-random-secret-key

# CSRF secret (generate a separate random string)
CSRF_SECRET=change-me-to-a-different-random-secret

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173

# Upload settings
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=uploads
CLEANED_DIR=cleaned

# Environment
ENVIRONMENT=development
