# Safe local-development settings. Copy to .env and edit the local PostgreSQL URL.
# Never use production database or R2 credentials in local tests.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/csv_data_quality_analyzer
SECRET_KEY=local-only-change-this-to-a-random-secret
CSRF_SECRET=local-only-use-a-different-random-secret
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SAMESITE=lax
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Development uses ignored local folders. Vercel production must use R2 instead.
STORAGE_BACKEND=local
MAX_UPLOAD_SIZE_MB=5
UPLOAD_DIR=uploads
CLEANED_DIR=cleaned

# Production-only backend settings. Keep these empty locally; set only on backend.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRESIGNED_URL_TTL_SECONDS=300
