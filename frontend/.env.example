# Keep empty when using the local Vite /api proxy.
# On Vercel, set the API project's HTTPS deployment origin (public URL, not a secret).
VITE_API_BASE_URL=

# Local development uploads use the local FastAPI multipart route.
# Vercel Production and Preview must set this to true for direct-to-R2 uploads.
VITE_DIRECT_UPLOAD=false

# Must match backend MAX_UPLOAD_SIZE_MB (1–5; default is 5).
VITE_MAX_UPLOAD_SIZE_MB=5
